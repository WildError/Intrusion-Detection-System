digraph ClassModel {
  graph [rankdir=TB, nodesep=0.7, ranksep=0.6, splines=ortho, pad=0.15];
  node [shape=record, style=filled, fillcolor="#f3f7fc", color="#65788a", fontname="DejaVu Sans", fontsize=19, margin="0.19,0.15"];
  DL [label="{DatasetLoader|+ load(path, labels_required)}"];
  SV [label="{SchemaValidator|+ validate(df, labels_required)}"];
  PF [label="{PipelineFactory|+ create(name, seed)}"];
  MT [label="{ModelTrainer|+ run(train_csv, out, seed)}"];
  TS [label="{ThresholdSelector|+ choose(y_true, probs)}"];
  PR [label="{PredictionService|+ run(model_dir, csv, out)}"];
  GM [label="{get_metrics|+ confusion_matrix / F1 / FPR}"];
  {rank=same; DL; SV;}
  {rank=same; PF; MT;}
  {rank=same; TS; PR;}
  {rank=same; GM;}
  DL -> PF [style=invis, weight=100];
  PF -> TS [style=invis, weight=100];
  TS -> GM [style=invis, weight=100];
  SV -> MT [style=invis, weight=100];
  MT -> PR [style=invis, weight=100];
  edge [color="#566b7f", penwidth=1.35, arrowsize=.7, constraint=false];
  DL -> SV;
  MT -> DL;
  MT -> PF;
  MT -> TS;
  PR -> DL;
  PR -> GM;
  TS -> GM;
}
